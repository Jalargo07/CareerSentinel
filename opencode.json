{
  "$schema": "https://opencode.ai/config.json",
  "username": "Jalargo07",
  "model": "opencode-go/mimo-v2.5",
  "subagent_depth": 4,
  "default_agent": "build",
  "agent": {
    "build": {
      "description": "Orquestador del proyecto. Escucha al usuario, delega a subagentes, reporta resultados. NUNCA escribe codigo.",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "ask",
        "task": "allow"
      }
    },
    "code": {
      "description": "Programador C# .NET 8. Implementa UNA tarea a la vez, ejecuta dotnet build, corrige errores.",
      "mode": "all",
      "model": "opencode-go/mimo-v2.5",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      }
    },
    "plan": {
      "description": "Planificador: clarifica requisitos y genera task.md antes de codificar. SOLO puede editar task.md.",
      "mode": "all",
      "model": "opencode-go/mimo-v2.5",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "deny",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      }
    },
    "review": {
      "description": "Auditor de codigo: revisa calidad, buenas practicas, emite APROBADO/RECHAZADO.",
      "mode": "all",
      "model": "opencode-go/hy3",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      }
    },
    "explore": {
      "description": "Explorador rapido de codebase. Busca archivos, patrones, responde preguntas del proyecto.",
      "mode": "all",
      "model": "opencode-go/mimo-v2.5",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      }
    },
    "general": {
      "description": "Agente general para investigacion compleja y tareas multi-paso.",
      "mode": "all",
      "model": "opencode-go/mimo-v2.5",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": "deny"
      }
    }
  }
}
